# Database
DATABASE_URL=postgresql://knuckles:knuckles@localhost:5432/knuckles

# App
DEBUG=false
KNUCKLES_BASE_URL=http://localhost:5001
FRONTEND_BASE_URL=http://localhost:3000

# JWT (RS256)
# Base64-encoded PEM-encoded private key (PKCS#8). Generate with:
#   openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
#   base64 -i private.pem
KNUCKLES_JWT_PRIVATE_KEY=
# Stable identifier published on the JWKS. Rotate by issuing a new kid.
KNUCKLES_JWT_KEY_ID=knuckles-2026-04
# Access token lifetime in seconds (default: 3600 = 1h)
KNUCKLES_ACCESS_TOKEN_TTL_SECONDS=3600
# Refresh token lifetime in seconds (default: 2592000 = 30d)
KNUCKLES_REFRESH_TOKEN_TTL_SECONDS=2592000

# Ceremony-state JWTs (short-lived, HS256) — OAuth and passkey state
KNUCKLES_STATE_SECRET=

# Magic link
MAGIC_LINK_TTL_SECONDS=900

# Resend (magic-link delivery)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Apple OAuth
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=

# WebAuthn
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Knuckles
WEBAUTHN_ORIGIN=http://localhost:3000

# CORS
# When false (default), Allow-Origin: *. When true, only echo origins
# registered in some app_clients.allowed_origins. See DECISIONS.md #013.
KNUCKLES_STRICT_CORS=false

# --- Per-tenant secret encryption (Decision #017) -------------------------
# Fernet key encrypting secret-bearing app_clients columns at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production. Empty in dev means encrypted tenant columns
# refuse to read or write — loud failure rather than silent plaintext.
# Losing this key bricks every encrypted column; back it up out-of-band.
# Rotation: set to NEW_KEY,OLD_KEY (new first), redeploy, run
#   python scripts/reencrypt_tenant_secrets.py
# then drop the old key.
KNUCKLES_SECRETS_KEY=

# --- Tenant-config env fallback (Decision #020) ----------------------------
# true (default): an app client with NULL tenant-config columns inherits
# the operator-level RESEND_*/GOOGLE_*/APPLE_*/WEBAUTHN_* values above.
# Set to false once every tenant row is fully provisioned to retire the
# fallback — NULL groups then fail loudly with TENANT_CONFIG_INCOMPLETE.
KNUCKLES_ALLOW_ENV_TENANT_FALLBACK=true
